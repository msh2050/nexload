{
  "manifest_version": 3,
  "name": "NexLoad Integration",
  "description": "Download videos and files with NexLoad — your Linux download manager",
  "version": "1.0.0",

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "NexLoad"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["*://*/*"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "webRequest",
    "declarativeNetRequest"
  ],
  "host_permissions": ["*://*/*"],

  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["*://*/*"]
    }
  ]
}
