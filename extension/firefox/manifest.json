{
  "manifest_version": 2,
  "name": "Nexload Sniffer",
  "version": "0.1.0",
  "description": "Detects downloadable videos and streams, sends them to Nexload.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "nativeMessaging",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sniffer@nexload.app",
      "strict_min_version": "109.0"
    }
  }
}
